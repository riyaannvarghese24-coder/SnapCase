{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SnapCase: run Django server",
            "type": "process",
            "command": "python",
            "args": [
                "manage.py",
                "runserver",
                "127.0.0.1:8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\Snapcase-Backend"
            },
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "django",
                    "pattern": {
                        "regexp": "^(.*)$",
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "Watching for file changes with StatReloader",
                        "endsPattern": "Starting development server at"
                    }
                }
            ]
        }
    ]
}
